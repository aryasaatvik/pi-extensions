{
  "name": "pi-extensions",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Pi coding agent extensions",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun run --filter './packages/*' typecheck",
    "test": "bun test scripts && bun run --filter './packages/*' test",
    "lint": "oxlint packages scripts *.config.ts",
    "format": "oxfmt packages scripts .github .tegami *.json *.config.ts README.md",
    "format:check": "oxfmt --check packages scripts .github .tegami *.json *.config.ts README.md",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "tegami": "bun scripts/tegami.mts",
    "release:check": "bun run check && bun run build && bun run test:artifact",
    "build": "bun run --filter @pi-ext/executor build",
    "test:artifact": "bun run --filter @pi-ext/executor test:artifact",
    "release:version": "bun run tegami version",
    "release:publish": "bun run tegami publish"
  },
  "devDependencies": {
    "@effect/tsgo": "0.57.0",
    "@types/node": "catalog:",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tegami": "1.5.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.2",
  "catalog": {
    "@types/node": "^26.0.0",
    "effect": "4.0.6",
    "typebox": "1.4.3",
    "vitest": "5.0.5",
    "tsdown": "0.23.2"
  },
  "catalogs": {
    "pi": {
      "@earendil-works/pi-ai": "1.4.0",
      "@earendil-works/pi-agent-core": "1.4.0",
      "@earendil-works/pi-coding-agent": "1.4.0",
      "@earendil-works/pi-tui": "1.4.0"
    }
  }
}
