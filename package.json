{
  "name": "pi-extensions",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for Pi coding agent extensions",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-language-service patch && effect-tsgo patch",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "test": "bun run --filter './packages/*' test",
    "lint": "oxlint packages",
    "format": "oxfmt packages scripts .github .tegami package.json README.md",
    "format:check": "oxfmt --check packages scripts .github .tegami package.json README.md",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "tegami": "bun scripts/tegami.mts",
    "version:packages": "bun run tegami version",
    "release:check": "bun run check",
    "release": "bun run release:check && bun run tegami publish"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.3",
    "@effect/tsgo": "^0.13.0",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "tegami": "1.4.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@types/node": "^25.0.0",
    "effect": "4.0.0",
    "typebox": "1.3.27",
    "vitest": "4.1.7"
  },
  "catalogs": {
    "pi": {
      "@earendil-works/pi-ai": "1.0.0",
      "@earendil-works/pi-agent-core": "1.0.0",
      "@earendil-works/pi-coding-agent": "1.0.0",
      "@earendil-works/pi-tui": "1.0.0"
    }
  }
}
