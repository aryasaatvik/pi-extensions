{
  "name": "@pi-ext/executor",
  "version": "1.0.0",
  "description": "Executor tools for Pi: search and run TypeScript against a hosted Executor's tool catalog.",
  "keywords": [
    "executor",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/aryasaatvik/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/aryasaatvik/pi-extensions/issues"
  },
  "license": "MIT",
  "author": "Saatvik Arya <aryasaatvik@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryasaatvik/pi-extensions.git"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/testing"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./extension": "./src/extension.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "smoke": "bun src/smoke.ts",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "catalog:pi",
    "@earendil-works/pi-ai": "catalog:pi",
    "@earendil-works/pi-coding-agent": "catalog:pi",
    "@earendil-works/pi-tui": "catalog:pi",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "typebox": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "typebox": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ]
  }
}
