{
  "name": "@pi-ext/executor",
  "version": "1.0.2",
  "description": "Executor tools for Pi: search and run TypeScript against a hosted Executor's tool catalog.",
  "keywords": [
    "executor",
    "pi-extension",
    "pi-package"
  ],
  "homepage": "https://github.com/aryasaatvik/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/aryasaatvik/pi-extensions/issues"
  },
  "license": "MIT",
  "author": "Saatvik Arya <aryasaatvik@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryasaatvik/pi-extensions.git",
    "directory": "packages/executor"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "smoke": "bun src/smoke.ts",
    "check": "bun run typecheck && bun run test",
    "build": "tsdown",
    "prepack": "bun run build",
    "check:package": "bun scripts/check-package.ts"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "catalog:pi",
    "@earendil-works/pi-ai": "catalog:pi",
    "@earendil-works/pi-coding-agent": "catalog:pi",
    "@earendil-works/pi-tui": "catalog:pi",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typebox": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.0.0",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "typebox": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ]
  }
}
